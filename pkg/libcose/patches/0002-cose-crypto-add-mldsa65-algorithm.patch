From 6e283362ca533000b112869eb127c6ea5c20bcdf Mon Sep 17 00:00:00 2001
From: RIOT buildsystem <buildsystem@riot>
Date: Fri, 17 Jul 2026 00:00:00 +0000
Subject: [PATCH] cose/crypto: add ML-DSA-65 algorithm and wolfCrypt backend

Adds COSE_ALGO_MLDSA65 (-49, per RFC 9964) and a verify-only
cose_crypto_verify_mldsa65() backend calling into wolfCrypt's
wc_MlDsaKey_VerifyCtx() (empty context, matching how Python's
`cryptography` library signs), selected via -DCRYPTO_WOLFCRYPT_MLDSA. No
cose_crypto_sign_mldsa65() is provided since SUIT firmware only ever
verifies manifests, never signs them on-device.
---
 include/cose/crypto.h                 | 19 +++++++++
 include/cose/crypto/keysizes.h        | 15 +++++++
 include/cose/crypto/wolfcrypt_mldsa.h | 41 +++++++++++++++++++
 include/cose_defines.h                |  1 +
 src/cose_crypto.c                     |  8 ++++
 src/crypt/wolfcrypt_mldsa.c           | 57 +++++++++++++++++++++++++++
 6 files changed, 141 insertions(+)
 create mode 100644 include/cose/crypto/wolfcrypt_mldsa.h
 create mode 100644 src/crypt/wolfcrypt_mldsa.c

diff --git a/include/cose/crypto.h b/include/cose/crypto.h
index 6df6d14..61ee1f2 100644
--- a/include/cose/crypto.h
+++ b/include/cose/crypto.h
@@ -51,6 +51,9 @@
 #ifdef CRYPTO_RIOT
 #include "cose/crypto/riot.h"
 #endif
+#ifdef CRYPTO_WOLFCRYPT_MLDSA
+#include "cose/crypto/wolfcrypt_mldsa.h"
+#endif
 
 #include "cose/crypto/selectors.h"
 
@@ -230,6 +233,22 @@ int cose_crypto_verify_ed25519(const cose_key_t *key, const uint8_t *sign, size_
  */
 void cose_crypto_keypair_ed25519(cose_key_t *key);
 void cose_crypto_keypair_ecdsa(cose_key_t *key, cose_curve_t curve);
+
+/**
+ * Verify a byte string and signature with an ML-DSA-65 public key
+ *
+ * Verify-only: SUIT firmware never signs on-device, so no
+ * cose_crypto_sign_mldsa65() is provided.
+ *
+ * @param       key     The Key struct to verify with
+ * @param[out]  sign    The signature
+ * @param       signlen The signature length
+ * @param       msg     The message to verify
+ * @param       msglen  The length of the message
+ *
+ * @return              0 if verification succeeded
+ */
+int cose_crypto_verify_mldsa65(const cose_key_t *key, const uint8_t *sign, size_t signlen, uint8_t *msg, uint64_t msglen);
 /** @} */
 
 /**
diff --git a/include/cose/crypto/keysizes.h b/include/cose/crypto/keysizes.h
index 6a939a8..32046c9 100644
--- a/include/cose/crypto/keysizes.h
+++ b/include/cose/crypto/keysizes.h
@@ -46,6 +46,21 @@ extern "C" {
  */
 #define COSE_CRYPTO_SIGN_ED25519_SIGNBYTES              64U
 
+/**
+ * @brief ML-DSA-65 public key size
+ */
+#define COSE_CRYPTO_SIGN_MLDSA65_PUBLICKEYBYTES         1952U
+
+/**
+ * @brief ML-DSA-65 secret key size
+ */
+#define COSE_CRYPTO_SIGN_MLDSA65_SECRETKEYBYTES         4032U
+
+/**
+ * @brief ML-DSA-65 signature size
+ */
+#define COSE_CRYPTO_SIGN_MLDSA65_SIGNBYTES              3309U
+
 /**
  * @brief Curve secp256r1 secret key size
  */

From a811e31852dc2468f63c33449b83232dab763f03 Mon Sep 17 00:00:00 2001
From: Miguel Arcilla <miguelkristopharcilla@gmail.com>
Date: Sat, 1 Aug 2026 17:04:45 +0200
Subject: [PATCH] cose/crypto: add ECDSA (ES256/384/512) wolfCrypt backend

Adds a verify-only wolfCrypt glue layer for ECDSA over the NIST P-256,
P-384 and P-521 curves, so SUIT manifests signed with the COSE-standard
ES256/ES384/ES512 algorithms can be verified on-device.

The generic cose_crypto_verify() dispatch already routes all three
algorithms to cose_crypto_verify_ecdsa() behind HAVE_ALGO_ECDSA, so only
the backend itself is new. Unlike the existing tinycrypt backend - which
declares HAVE_ALGO_ECDSA but implements P-256 only, and would read 32
bytes of a 48-byte coordinate for an ES384 key - this backend advertises
per-curve HAVE_CURVE_P256/P384/P521 and rejects a curve that was not
compiled into wolfCrypt.

COSE carries the signature as fixed-width r||s rather than ASN.1, so
verification goes through wc_ecc_verify_hash_ex() with mp_ints, and the
signature length is validated against the curve's coordinate width.
---
 include/cose/crypto.h                 |   3 +
 include/cose/crypto/wolfcrypt_ecdsa.h |  51 +++++++++
 src/crypt/wolfcrypt_ecdsa.c           | 142 ++++++++++++++++++++++++++
 3 files changed, 196 insertions(+)
 create mode 100644 include/cose/crypto/wolfcrypt_ecdsa.h
 create mode 100644 src/crypt/wolfcrypt_ecdsa.c

diff --git a/include/cose/crypto.h b/include/cose/crypto.h
index 69ad508..408626c 100644
--- a/include/cose/crypto.h
+++ b/include/cose/crypto.h
@@ -54,6 +54,9 @@
 #ifdef CRYPTO_WOLFCRYPT_MLDSA
 #include "cose/crypto/wolfcrypt_mldsa.h"
 #endif
+#ifdef CRYPTO_WOLFCRYPT_ECDSA
+#include "cose/crypto/wolfcrypt_ecdsa.h"
+#endif
 
 #include "cose/crypto/selectors.h"
 
diff --git a/include/cose/crypto/wolfcrypt_ecdsa.h b/include/cose/crypto/wolfcrypt_ecdsa.h
new file mode 100644
index 0000000..b328b0f
--- /dev/null
+++ b/include/cose/crypto/wolfcrypt_ecdsa.h
@@ -0,0 +1,51 @@
+/*
+ * Copyright (C) 2026 Freie Universitat Berlin
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+#ifndef COSE_CRYPTO_WOLFCRYPT_ECDSA_H
+#define COSE_CRYPTO_WOLFCRYPT_ECDSA_H
+
+#include <wolfssl/wolfcrypt/settings.h>
+#include <wolfssl/wolfcrypt/ecc.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * @name List of provided algorithms
+ *
+ * @{
+ */
+#ifdef HAVE_ECC
+#define HAVE_ALGO_ECDSA     /**< ECDSA support */
+
+/* Advertised per curve, deliberately: libcose's cose_crypto_verify() gates
+ * all three of ES256/ES384/ES512 behind the single HAVE_ALGO_ECDSA, so a
+ * backend that only implements one curve still gets handed manifests signed
+ * with the others. The tinycrypt backend has exactly that bug - it declares
+ * HAVE_ALGO_ECDSA but only implements P-256, so an ES384 signature is
+ * verified by reading 32 bytes of a 48-byte coordinate. These per-curve
+ * defines let cose_crypto_verify_ecdsa() below reject a curve that wasn't
+ * compiled in, rather than silently misparsing the key. */
+#if defined(HAVE_ECC256) || defined(HAVE_ALL_CURVES)
+#define HAVE_CURVE_P256     /**< EC NIST P-256 curve support */
+#endif
+#if defined(HAVE_ECC384) || defined(HAVE_ALL_CURVES)
+#define HAVE_CURVE_P384     /**< EC NIST P-384 curve support */
+#endif
+#if defined(HAVE_ECC521) || defined(HAVE_ALL_CURVES)
+#define HAVE_CURVE_P521     /**< EC NIST P-521 curve support */
+#endif
+#endif /* HAVE_ECC */
+/** @} */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* COSE_CRYPTO_WOLFCRYPT_ECDSA_H */
diff --git a/src/crypt/wolfcrypt_ecdsa.c b/src/crypt/wolfcrypt_ecdsa.c
new file mode 100644
index 0000000..4ac859c
--- /dev/null
+++ b/src/crypt/wolfcrypt_ecdsa.c
@@ -0,0 +1,142 @@
+/*
+ * Copyright (C) 2026 Freie Universitat Berlin
+ *
+ * This file is subject to the terms and conditions of the GNU Lesser
+ * General Public License v2.1. See the file LICENSE in the top level
+ * directory for more details.
+ */
+
+/**
+ * Glue layer between libcose and wolfCrypt's ECDSA implementation
+ * (ES256/ES384/ES512 over the NIST P-256/P-384/P-521 curves).
+ * Verify-only: SUIT firmware never signs manifests on-device.
+ */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <wolfssl/wolfcrypt/ecc.h>
+#include <wolfssl/wolfcrypt/hash.h>
+#include <wolfssl/wolfcrypt/integer.h>
+
+#include "cose_defines.h"
+#include "cose/crypto.h"
+#include "cose/crypto/wolfcrypt_ecdsa.h"
+
+#ifdef HAVE_ALGO_ECDSA
+
+/* wolfCrypt's ecc_key embeds mp_int coordinates sized by MAX_ECC_BITS, which
+ * follows the largest curve compiled in (up to 521 bits). Keeping it static
+ * rather than as a stack local mirrors the ML-DSA backend: SUIT verification
+ * only ever runs on the single suit_worker thread, and an oversized frame
+ * there silently overflowed the worker stack during ML-DSA bring-up, making
+ * genuinely valid signatures fail. */
+static ecc_key _ecc_key;
+
+/**
+ * @brief Map a COSE curve to its wolfCrypt id, coordinate width and hash.
+ *
+ * @return 0 on success, -1 if the curve is unknown or was not compiled in.
+ */
+static int _curve_params(cose_curve_t crv, int *curve_id, size_t *coord_len,
+                         enum wc_HashType *hash_type)
+{
+    switch (crv) {
+#ifdef HAVE_CURVE_P256
+        case COSE_EC_CURVE_P256:
+            *curve_id = ECC_SECP256R1;
+            *coord_len = COSE_CRYPTO_SIGN_P256_PUBLICKEYBYTES;
+            *hash_type = WC_HASH_TYPE_SHA256;
+            return 0;
+#endif
+#ifdef HAVE_CURVE_P384
+        case COSE_EC_CURVE_P384:
+            *curve_id = ECC_SECP384R1;
+            *coord_len = COSE_CRYPTO_SIGN_P384_PUBLICKEYBYTES;
+            *hash_type = WC_HASH_TYPE_SHA384;
+            return 0;
+#endif
+#ifdef HAVE_CURVE_P521
+        case COSE_EC_CURVE_P521:
+            *curve_id = ECC_SECP521R1;
+            /* P-521's 521 bits round up to 66 bytes, not 65 */
+            *coord_len = COSE_CRYPTO_SIGN_P521_PUBLICKEYBYTES;
+            *hash_type = WC_HASH_TYPE_SHA512;
+            return 0;
+#endif
+        default:
+            return -1;
+    }
+}
+
+int cose_crypto_verify_ecdsa(const cose_key_t *key, const uint8_t *sign,
+                             size_t signlen, uint8_t *msg, size_t msglen)
+{
+    int curve_id;
+    size_t coord_len;
+    enum wc_HashType hash_type;
+    uint8_t digest[WC_MAX_DIGEST_SIZE];
+    mp_int r, s;
+    int verify_result = 0;
+    int ret;
+
+    if (_curve_params(key->crv, &curve_id, &coord_len, &hash_type) < 0) {
+        return COSE_ERR_NOTIMPLEMENTED;
+    }
+
+    /* COSE carries the signature as fixed-width r||s (RFC 9053), so its
+     * length is fully determined by the curve. libcose passes signlen
+     * through without checking it - the tinycrypt backend just discards it -
+     * so validate here rather than trusting the two halves to line up. */
+    if (!key->x || !key->y || signlen != 2 * coord_len) {
+        return COSE_ERR_CRYPTO;
+    }
+
+    int digest_len = wc_HashGetDigestSize(hash_type);
+    if (digest_len <= 0) {
+        return COSE_ERR_NOTIMPLEMENTED;
+    }
+
+    if (wc_Hash(hash_type, msg, msglen, digest, (word32)digest_len) != 0) {
+        return COSE_ERR_CRYPTO;
+    }
+
+    ret = wc_ecc_init(&_ecc_key);
+    if (ret != 0) {
+        return COSE_ERR_CRYPTO;
+    }
+
+    /* x and y are separate pointers in cose_key_t; RIOT's generated
+     * public_key.h stores them concatenated and points y at the halfway
+     * mark (see sys/suit/handlers_envelope.c). */
+    ret = wc_ecc_import_unsigned(&_ecc_key, (const byte *)key->x,
+                                 (const byte *)key->y, NULL, curve_id);
+
+    if (ret == 0) {
+        /* wc_ecc_verify_hash() expects an ASN.1/DER signature; COSE's raw
+         * r||s has to go in as mp_ints via the _ex variant instead. */
+        if (mp_init_multi(&r, &s, NULL, NULL, NULL, NULL) == MP_OKAY) {
+            if (mp_read_unsigned_bin(&r, sign, (word32)coord_len) == MP_OKAY &&
+                mp_read_unsigned_bin(&s, sign + coord_len,
+                                     (word32)coord_len) == MP_OKAY) {
+                ret = wc_ecc_verify_hash_ex(&r, &s, digest, (word32)digest_len,
+                                            &verify_result, &_ecc_key);
+            }
+            else {
+                ret = -1;
+            }
+            mp_clear(&r);
+            mp_clear(&s);
+        }
+        else {
+            ret = -1;
+        }
+    }
+
+    wc_ecc_free(&_ecc_key);
+
+    return (ret == 0 && verify_result == 1) ? COSE_OK : COSE_ERR_CRYPTO;
+}
+
+#endif /* HAVE_ALGO_ECDSA */
-- 
2.34.1


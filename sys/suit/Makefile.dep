USEPKG += nanocbor
USEPKG += libcose
USEMODULE += uuid

ifneq (,$(filter suit_algo_mldsa%,$(USEMODULE)))
  USEMODULE += libcose_crypt_wolfcrypt_mldsa
  # map each suit_algo_mldsaXX to the wolfcrypt_mldsaXX pseudomodule that
  # keeps that ML-DSA parameter set compiled into wolfCrypt (see
  # pkg/wolfssl/include/user_settings.h)
  USEMODULE += $(patsubst suit_algo_%,wolfcrypt_%,$(filter suit_algo_mldsa%,$(USEMODULE)))
endif

# ECDSA over the NIST curves (COSE ES256/ES384/ES512). One backend covers all
# three; the curve pseudomodules trim which ones wolfCrypt compiles in.
ifneq (,$(filter suit_algo_es%,$(USEMODULE)))
  USEMODULE += libcose_crypt_wolfcrypt_ecdsa
  ifneq (,$(filter suit_algo_es384,$(USEMODULE)))
    USEMODULE += wolfcrypt_ecc_p384
  endif
  ifneq (,$(filter suit_algo_es512,$(USEMODULE)))
    # ES512 is P-521, not a 512-bit curve
    USEMODULE += wolfcrypt_ecc_p521
  endif
endif

ifeq (,$(filter libcose_crypt_%,$(USEMODULE)))
  USEMODULE += libcose_crypt_c25519
endif

# firmware-payload decryption reuses the manifest-decryption crypto
# (shared COSE_Encrypt parsing / CEK derivation in sys/suit/encrypt and
# the same embedded device key), so it implies that module
ifneq (,$(filter suit_firmware_encrypt,$(USEMODULE)))
  USEMODULE += suit_manifest_encrypt
endif

# manifest decryption: X25519 via the c25519 pkg (its fprime_* symbols
# collide with wolfCrypt's fe_low_mem.c, so wolfCrypt's own CURVE25519_SMALL
# implementation can't coexist with the libcose c25519 signature backend);
# HKDF-SHA256 + ChaCha20-Poly1305 via wolfCrypt (chacha20_poly1305 is
# auto-selected by chacha + poly1305 in pkg/wolfssl/Makefile.dep; HKDF rides
# on hmac, see user_settings.h)
ifneq (,$(filter suit_manifest_encrypt,$(USEMODULE)))
  USEPKG += c25519
  USEPKG += wolfssl
  USEMODULE += wolfcrypt
  USEMODULE += wolfcrypt_chacha
  USEMODULE += wolfcrypt_poly1305
  USEMODULE += wolfcrypt_hmac
endif

ifneq (,$(filter suit_transport_%, $(USEMODULE)))
  USEMODULE += suit_transport
  USEMODULE += suit_transport_worker
endif

# performance/memory checkpoints: microsecond timing for the crypto phases
# (ztimer_msec, pulled in by the CoAP transport below, is far too coarse for
# an Ed25519 verification) and heap accounting to show at runtime that the
# wolfCrypt WOLFSSL_NO_MALLOC configuration really does keep ML-KEM off the
# heap. The stack canary this module reads additionally needs
# -DSCHED_TEST_STACK=1, set next to USEMODULE += suit_perf by the application.
ifneq (,$(filter suit_perf, $(USEMODULE)))
  USEMODULE += ztimer_usec
  USEMODULE += malloc_monitor
endif

ifneq (,$(filter suit_transport_coap, $(USEMODULE)))
  USEMODULE += nanocoap_sock
  USEMODULE += ztimer_msec
  USEMODULE += sock_util
endif

ifneq (,$(filter suit_transport_vfs, $(USEMODULE)))
  USEMODULE += vfs_util
endif

ifneq (,$(filter suit_storage_%, $(USEMODULE)))
  USEMODULE += suit_storage
endif

ifneq (,$(filter suit_storage_flashwrite, $(USEMODULE)))
  FEATURES_REQUIRED += riotboot
  USEMODULE += riotboot_slot
  USEMODULE += riotboot_flashwrite
  USEMODULE += riotboot_flashwrite_verify_sha256
endif

ifneq (,$(filter suit_storage_vfs,$(USEMODULE)))
  USEMODULE += vfs
  USEMODULE += mtd
endif
